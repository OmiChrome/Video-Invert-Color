{
  "manifest_version": 3,
  "name": "Midnight Owl: Dark Mode for Lectures",
  "short_name": "Midnight Owl",
  "version": "1.1.0",
  "description": "Watch lectures and videos in a dark room. Turns bright boards and slides dark; keeps faces, photos and colours natural. Press O.",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "Midnight Owl (O or Alt+O)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "filters.js",
        "engine.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Turn Midnight Owl on or off"
    }
  }
}
